# Local automation credentials for HealthyBrain.ai setup.
# Copy this file to `.env.local`, fill in real values, and do not commit it.
#
# If this file is absent, scripts also try to load:
# ../wolfgang-ganglberger.github.io/.env.local

# GitHub token for the GitHub repository that will host this holding page.
# Required repository permissions for a fine-grained PAT:
# - Pages: read and write
# - Administration: read and write
# If reusing the personal-site token, edit it to include `healthybrain.ai`.
GITHUB_TOKEN=

# Porkbun API credentials with API access enabled for healthybrain.ai.
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=

# Optional overrides. Defaults are correct for this holding page.
# GITHUB_OWNER=wolfgang-ganglberger
# GITHUB_REPO=healthybrain.ai
# GITHUB_PAGES_CUSTOM_DOMAIN=healthybrain.ai
# GITHUB_PAGES_SOURCE_BRANCH=main
# GITHUB_PAGES_SOURCE_PATH=/
# GITHUB_PAGES_ENFORCE_HTTPS=false
